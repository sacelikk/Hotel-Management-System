<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.apache.maven.archetypes.hotelflow.Controller.RoomsController">

    <!-- Üst Başlık ve Yeni Oda Butonu -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Rooms &amp; Live Availability" textFill="#0f172a">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Label text="Complete directory of hotel rooms, categories, pricing, and live room occupancy." textFill="#64748b">
                <font>
                    <Font size="13.0" />
                </font>
            </Label>
        </VBox>
        <Button onAction="#handleNewRoom" text="+ Add New Room"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
    </HBox>

    <!-- Hızlı Durum Kartları (KPI Mini Rozetleri) -->
    <HBox spacing="12.0">
        <HBox spacing="8.0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <Label text="Total Rooms:" textFill="#64748b" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <Label fx:id="lblTotalRooms" text="0" textFill="#0f172a" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <Label text="Available (Vacant):" textFill="#15803d" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <Label fx:id="lblAvailableRooms" text="0" textFill="#15803d" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <Label text="Occupied:" textFill="#b91c1c" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <Label fx:id="lblOccupiedRooms" text="0" textFill="#b91c1c" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        </HBox>

        <HBox spacing="8.0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-padding: 10 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <Label text="Maintenance:" textFill="#d97706" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <Label fx:id="lblMaintenanceRooms" text="0" textFill="#d97706" style="-fx-font-size: 14px; -fx-font-weight: bold;" />
        </HBox>
    </HBox>

    <!-- Filtreleme Çubuğu -->
    <HBox alignment="CENTER_LEFT" spacing="12.0"
          style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <TextField fx:id="searchField" promptText="Search Room # (e.g. 201, 305)..." prefWidth="250.0"
                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

        <ComboBox fx:id="floorFilterCombo" promptText="Floor" prefWidth="120.0"
                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />

        <ComboBox fx:id="categoryFilterCombo" promptText="Category" prefWidth="140.0"
                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />

        <ComboBox fx:id="statusFilterCombo" promptText="Status" prefWidth="140.0"
                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#handleResetFilters" text="Reset"
                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;" />
    </HBox>

    <!-- Odalar Tablosu -->
    <TableView fx:id="roomsTable" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colRoomNumber" text="Room No" prefWidth="100.0" />
            <TableColumn fx:id="colFloor" text="Floor" prefWidth="80.0" />
            <TableColumn fx:id="colCategory" text="Category" prefWidth="130.0" />
            <TableColumn fx:id="colCapacity" text="Capacity" prefWidth="90.0" />
            <TableColumn fx:id="colPrice" text="Base Price" prefWidth="110.0" />
            <TableColumn fx:id="colStatus" text="Live Status" prefWidth="150.0" />
            <TableColumn fx:id="colCurrentGuest" text="Current Occupancy / Details" prefWidth="240.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Alt Bilgi ve Aksiyon Çubuğu -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Label fx:id="statusMessageLabel" text="Total 7 hotel rooms listed." textFill="#64748b" HBox.hgrow="ALWAYS" maxWidth="Infinity" />

        <Button onAction="#handleToggleMaintenance" text="🛠️ Toggle Maintenance"
                style="-fx-background-color: #fef3c7; -fx-text-fill: #b45309; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />

        <Button onAction="#handleRefresh" text="🔄 Refresh"
                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
    </HBox>

</VBox>
