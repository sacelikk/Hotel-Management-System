<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0" style="-fx-background-color: transparent;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.apache.maven.archetypes.hotelflow.Controller.ReservationsController">

    <!-- Başlık ve Üst Buton Çubuğu -->
    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Reservations" textFill="#0f172a">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Label text="Monitor active bookings, create new reservations, or process cancellations." textFill="#64748b">
                <font>
                    <Font size="13.0" />
                </font>
            </Label>
        </VBox>
        <Button onAction="#handleNewReservation" text="+ New Reservation"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
    </HBox>

    <!-- Filtreleme Çubuğu -->
    <HBox alignment="CENTER_LEFT" spacing="12.0"
          style="-fx-background-color: white; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <TextField fx:id="searchField" promptText="Search by Booking # or Client ID..." prefWidth="280.0"
                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-padding: 6 10;" />

        <ComboBox fx:id="statusFilterCombo" promptText="Filter by Status" prefWidth="180.0"
                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#handleResetFilters" text="Reset"
                style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14;" />
    </HBox>

    <!-- Rezervasyon Tablosu -->
    <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colBookingNumber" text="Booking #" prefWidth="130.0" />
            <TableColumn fx:id="colClientId" text="Client ID" prefWidth="90.0" />
            <TableColumn fx:id="colRoomId" text="Room ID" prefWidth="90.0" />
            <TableColumn fx:id="colStartDate" text="Check-In" prefWidth="120.0" />
            <TableColumn fx:id="colEndDate" text="Check-Out" prefWidth="120.0" />
            <TableColumn fx:id="colType" text="Type" prefWidth="110.0" />
            <TableColumn fx:id="colCancellation" text="Cancellation" prefWidth="130.0" />
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Alt İşlem Çubuğu -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Label fx:id="tableStatusLabel" text="Showing bookings" textFill="#64748b" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
        <Button onAction="#handleCancelBooking" text="Cancel Selected"
                style="-fx-background-color: #fee2e2; -fx-text-fill: #991b1b; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
        <Button onAction="#handleCheckInSelected" text="Check-In Selected"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 8 16; -fx-cursor: hand;" />
    </HBox>

</VBox>